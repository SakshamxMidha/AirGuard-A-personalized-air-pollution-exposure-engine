# AirGuard Environment Configuration
# Copy this file to .env and fill in values

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-256bit-key-in-production

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=airguard_change_in_production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ── Optional: WAQI Token ─────────────────────────────────────────────────────
# Register free at https://aqicn.org/data-platform/token/
# Leave empty to use 'demo' token (limited but functional)
WAQI_TOKEN=
